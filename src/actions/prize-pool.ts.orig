"use server";

import { desc, eq, and } from "drizzle-orm";
import { db } from "@/db";
import { prizePools, prizePoolEntries, prizeDraws } from "@/db/schema";
import { getSession } from "@/lib/session";

async function getAuthAddress() {
  const session = await getSession();
  if (!session.address) {
    throw new Error("Unauthorized");
  }
  return session.address;
}

export async function getCurrentPrizePool() {
  let activePool = await db.select().from(prizePools).where(eq(prizePools.status, "open")).limit(1);
  let pool = activePool[0];

  if (!pool) {
    // Seed a new pool if none exists
    const nextDrawDate = new Date();
    nextDrawDate.setDate(nextDrawDate.getDate() + (7 - nextDrawDate.getDay())); // Next Sunday
    
    const id = crypto.randomUUID();
    await db.insert(prizePools).values({
      id,
      status: "open",
      currentYieldPotUSDC: 0,
      drawStartsAt: nextDrawDate,
    });

    const created = await db.select().from(prizePools).where(eq(prizePools.id, id)).limit(1);
    pool = created[0];
  }

  // Get participants count
  const entries = await db.select().from(prizePoolEntries).where(eq(prizePoolEntries.poolId, pool.id));
  const participantsCount = entries.length;
  const totalDeposited = entries.reduce((acc, e) => acc + e.principalDepositedUSDC, 0);

  // Simulate yield for hackathon demo purposes (14% APY for 1 week on total deposited)
  // Yield = Principal * 0.14 * (7/365)
  const simulatedYield = totalDeposited * 0.14 * (7 / 365);

  return {
    ...pool,
    currentYieldPotUSDC: Math.max(pool.currentYieldPotUSDC, simulatedYield),
    participantsCount,
    totalDeposited,
  };
}

export async function enterPrizePool(amountUSDC: number) {
  const address = await getAuthAddress();
  const pool = await getCurrentPrizePool();

  const existingEntry = await db.select().from(prizePoolEntries)
    .where(
      and(
        eq(prizePoolEntries.poolId, pool.id),
        eq(prizePoolEntries.walletAddress, address)
      )
    )
    .limit(1);

  if (existingEntry.length > 0) {
    throw new Error("Already entered into this week's pool");
  }

  await db.insert(prizePoolEntries).values({
    id: crypto.randomUUID(),
    poolId: pool.id,
    walletAddress: address,
    principalDepositedUSDC: amountUSDC,
    yieldContributedUSDC: 0, // In reality, yield accumulates over the week
  });

  return { success: true };
}

export async function getPrizeHistory(limit = 10) {
  await getAuthAddress(); // Just to enforce auth
  return db.select().from(prizeDraws).orderBy(desc(prizeDraws.executedAt)).limit(limit);
}

export async function drawPrizeWinner() {
  await getAuthAddress(); // Just to enforce auth (could be admin only ideally)
  const activePool = await db.select().from(prizePools).where(eq(prizePools.status, "open")).limit(1);
  if (activePool.length === 0) throw new Error("No open prize pool");
  const pool = activePool[0];

  const entries = await db.select().from(prizePoolEntries).where(eq(prizePoolEntries.poolId, pool.id));
  if (entries.length === 0) {
    throw new Error("No entries in the current pool");
  }

  // Pick a winner randomly
  const winnerIndex = Math.floor(Math.random() * entries.length);
  const winner = entries[winnerIndex];

  const totalDeposited = entries.reduce((acc, e) => acc + e.principalDepositedUSDC, 0);
  const simulatedYield = totalDeposited * 0.14 * (7 / 365);
  const jackpotAmount = Math.max(pool.currentYieldPotUSDC, simulatedYield);

  if (jackpotAmount <= 0) {
    throw new Error("Jackpot is zero, wait for yield");
  }

  // Update pool status
  await db.update(prizePools).set({ status: "completed", currentYieldPotUSDC: jackpotAmount }).where(eq(prizePools.id, pool.id));

  // Insert draw record
  await db.insert(prizeDraws).values({
    id: crypto.randomUUID(),
    poolId: pool.id,
    winnerAddress: winner.walletAddress,
    jackpotAmountUSDC: jackpotAmount,
    txHash: "0xsimulated" + crypto.randomUUID().replace(/-/g, ""),
  });

  return { success: true, winner: winner.walletAddress, jackpot: jackpotAmount };
}
